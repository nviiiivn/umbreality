# Umbrella AI .gitignore

# Environment
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# Node
node_modules/
npm-debug.log*

# Logs
logs/
*.log

# Sandbox outputs (ephemeral)
sandbox/*.json
sandbox/*.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local config
opencode.json
